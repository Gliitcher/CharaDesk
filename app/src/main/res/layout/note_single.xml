<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/note_menu" />
        <LinearLayout
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_text_sub"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/note_text"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/transparent"
                android:inputType="text"
                android:maxLines="1"
                android:maxLength="25"
                android:ellipsize="end"
                android:textSize="@dimen/SubText"
                android:paddingTop="@dimen/paddingL"
                android:paddingBottom="@dimen/paddingL"
                android:paddingRight="@dimen/paddingB"
                android:paddingLeft="@dimen/paddingB"
                android:clickable="true"
                android:focusable="true"
                />
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="onClickMenu"
                android:src="@drawable/icon_menu" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>