<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:backgroundTint="@color/transparent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/note_menu" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_text_sub"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/title_text"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/title_hint"
                    android:textColorHint="@color/black_hint"
                    android:textColor="@color/black_title"
                    android:backgroundTint="@color/transparent"
                    android:maxLines="3"
                    android:inputType="textMultiLine"
                    android:singleLine="false"
                    android:maxLength="64"
                    android:ellipsize="end"
                    android:textSize="@dimen/NoteTitle"
                    android:paddingTop="@dimen/paddingL"
                    android:paddingBottom="@dimen/paddingL"
                    android:paddingRight="@dimen/paddingB"
                    android:paddingLeft="@dimen/paddingB"
                    android:clickable="true"
                    />
                <ImageButton
                    android:id="@+id/note_menu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:onClick="onClickMenu"
                    android:src="@drawable/icon_menu"
                    android:background="@drawable/rounded_buttons"
                    app:tint="@color/CharaIconBorder"
                    android:layout_margin="@dimen/paddingL"
                    android:layout_gravity="center"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/CharaBorderSub" />
            <EditText
                android:id="@+id/note_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/text_hint"
                android:textColorHint="@color/black_hint"
                android:textColor="@color/black_title"
                android:inputType="textMultiLine"
                android:ellipsize="end"
                android:textSize="@dimen/NoteText"
                android:backgroundTint="@color/transparent"
                android:paddingTop="@dimen/paddingL"
                android:paddingBottom="@dimen/paddingL"
                android:paddingRight="@dimen/paddingB"
                android:paddingLeft="@dimen/paddingB"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>